# Single env file for both frontend and backend.
# Copy this to .env at the project root (AccessiOffice/.env).
# Do NOT create a separate backend/.env.

# Frontend (Vite)
VITE_API_URL=http://localhost:4000

# Backend
PORT=4000

# PowerPoint Office Engine
PPTX_WORKER_ENABLED=true
PPTX_WORKER_TIMEOUT_MS=45000
PPTX_WORKER_CONCURRENCY=1
PPTX_WORKER_DEBUG=false

# Word Office Engine
WORD_WORKER_ENABLED=true
WORD_WORKER_TIMEOUT_MS=45000
WORD_WORKER_DEBUG=false

# Excel Office Engine
EXCEL_WORKER_ENABLED=true
EXCEL_WORKER_TIMEOUT_MS=45000
EXCEL_WORKER_DEBUG=false
